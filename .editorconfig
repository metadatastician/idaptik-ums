#
# https://editorconfig.org
#
# Deliberately lists the languages this repository actually contains. The
# previous version was a template artefact whose glob named py, ts, js, go,
# java and more, languages the estate bans. An editor config that configures
# indentation for banned languages is a small thing, but it is the same
# category of drift as a README describing a runtime the project does not use.
# Indent sizes follow what the tracked files already use.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Rust, and rustfmt's default.
[*.rs]
indent_size = 4

# Zig, and `zig fmt`'s default.
[*.zig]
indent_size = 4

# Idris2.
[*.{idr,ipkg}]
indent_size = 2

# Ada/SPARK, and the GNAT style's default.
[*.{ads,adb,gpr}]
indent_size = 3

# Nickel: the generative source of truth.
[*.ncl]
indent_size = 2

# Data and config.
[*.{json,yml,yaml,kyaml,toml}]
indent_size = 2

# Prose. Trailing whitespace is meaningful in Markdown line breaks, but this
# repo does not use them, so trimming stays on.
[*.{md,adoc}]
indent_size = 2
max_line_length = 80

[*.{sh,bash}]
indent_size = 4

# just uses significant indentation inside recipes.
[{justfile,Justfile}]
indent_size = 4

# Licence texts are reproduced verbatim.
[LICENSES/**]
trim_trailing_whitespace = false
insert_final_newline = false

[LICENSE]
trim_trailing_whitespace = false
insert_final_newline = false
